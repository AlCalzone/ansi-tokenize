{
	"extends": "@tsconfig/node22",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		// Never emit faulty JS
		"noEmitOnError": true,
		"outDir": "build/",
		"removeComments": false,
		"verbatimModuleSyntax": true,
		// Required for TS debugging
		"sourceMap": true,
		"inlineSourceMap": false,
		"preserveWatchOutput": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"exclude": []
}
