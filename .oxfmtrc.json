{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": true,
	"trailingComma": "all",
	"singleQuote": false,
	"printWidth": 100,
	"useTabs": true,
	"tabWidth": 4,
	"endOfLine": "lf",
	"sortPackageJson": false,
	"ignorePatterns": [
		".github/workflows/",
		"CHANGELOG*.md",
		"README.md",
		"package.json",
		"build/"
	],
	"overrides": [
		{
			"files": ["*.yml", "*.yaml", "*.md"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
