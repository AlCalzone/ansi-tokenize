{
  "name": "@alcalzone/ansi-tokenize",
  "version": "0.3.2",
  "description": "Efficiently modify strings containing ANSI escape codes",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "AlCalzone",
    "email": "d.griesel@gmx.net"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/AlCalzone/ansi-tokenize",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlCalzone/ansi-tokenize.git"
  },
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@alcalzone/release-script": "~5.2.1",
    "@alcalzone/release-script-plugin-license": "~5.2.2",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.19.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ansi-styles": "^7.0.0",
    "is-fullwidth-code-point": "^5.0.0"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "release": "release-script"
  },
  "packageManager": "yarn@4.18.1"
}
